# Copy to .env before running: cp .env.example .env
# These defaults are for local development only. Change every value for any shared or public deployment.

POSTGRES_USER=bloodapp
POSTGRES_PASSWORD=bloodapp_dev

RABBITMQ_USER=bloodapp
RABBITMQ_PASSWORD=bloodapp_dev

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev
# The URL clients (mobile app, curl) use to reach Keycloak. It becomes the token issuer,
# so it must be the same address everywhere. For an Android emulator use http://10.0.2.2:8080,
# for a phone on the same Wi-Fi use http://<your-computer-ip>:8080.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_PORT=8080

# T.C. identity verification. NVİ closed its public service on 30.09.2025; only institutions with KPS
# access can verify identities (see docs/identity-verification.md). With None the number is not collected.
IDENTITY_VERIFICATION_PROVIDER=None
# Secret key for hashing identity numbers. Required when the provider is not None. Generate one with:
#   openssl rand -base64 32
IDENTITY_HASH_KEY=

# Outgoing email (notification-service). The defaults deliver to Mailpit: http://localhost:8025
# For Gmail use smtp.gmail.com, 587, SMTP_USE_TLS=true and an app password.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@bloodapp.local
# Support address shown in notification emails; leave empty to omit it.
SUPPORT_EMAIL=

# How long a post stays active (d.hh:mm:ss) and how often expired posts are checked.
# Set POST_ACTIVE_DURATION=00:02:00 to watch expiry happen while testing.
POST_ACTIVE_DURATION=3.00:00:00
POST_EXPIRY_CHECK_INTERVAL=00:01:00

# Host port the API gateway listens on
GATEWAY_PORT=8000
